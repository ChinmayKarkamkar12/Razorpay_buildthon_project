# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI).
# Copy this file to .env and fill in real values. .env is gitignored; this file is not.
# If your password contains special characters (@ : / ? # [ ] $), URL-encode them
# (@ -> %40, $ -> %24, etc.) or the URI will not parse.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Google Gemini (free tier, no card): https://aistudio.google.com/apikey
# Optional — the deterministic pipeline runs without it; unset means the AI layer
# is disabled and every re-auth message / unmapped-code bucket uses a safe fallback.
# Do NOT enable billing on the Google Cloud project (removes the free tier).
GEMINI_API_KEY=
